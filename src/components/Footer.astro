---
// Footer from the devportfolio template by Ryan Fitzgerald (MIT License):
// https://github.com/RyanFitzgerald/devportfolio
// Customised: social links now render only when set, and a template credit was added.
import { siteConfig } from "../config";

const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
const hasEducation = siteConfig.education && siteConfig.education.length > 0;

const iconPaths = {
  email: [
    "M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z",
    "M3 7l9 6l9 -6",
  ],
  linkedin: [
    "M8 11v5",
    "M8 8v.01",
    "M12 16v-5",
    "M16 16v-3a2 2 0 1 0 -4 0",
    "M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z",
  ],
  twitter: ["M4 4l11.733 16h4.267l-11.733 -16z", "M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"],
  github: [
    "M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5",
  ],
};

const social = siteConfig.social ?? {};
const socialLinks = [
  social.email && { label: "Email", href: `mailto:${social.email}`, icon: iconPaths.email, external: false },
  social.linkedin && { label: "LinkedIn", href: social.linkedin, icon: iconPaths.linkedin, external: true },
  social.twitter && { label: "Twitter", href: social.twitter, icon: iconPaths.twitter, external: true },
  social.github && { label: "GitHub", href: social.github, icon: iconPaths.github, external: true },
].filter(Boolean) as {
  label: string;
  href: string;
  icon: string[];
  external: boolean;
}[];
---

<footer class="relative bg-gray-50 border-t border-gray-200">
  <div class="mx-auto max-w-6xl px-6 py-12 lg:px-8">
    <div
      class="flex flex-col md:flex-row md:items-center md:justify-between gap-8"
    >
      <div class="flex flex-col gap-4">
        <h3 class="text-2xl font-bold text-gray-800">
          {siteConfig.name}
        </h3>
        <p class="text-base text-gray-600">
          {siteConfig.title}
        </p>
        <div class="flex gap-x-6">
          {
            socialLinks.map((link) => (
              <a
                href={link.href}
                aria-label={link.label}
                {...(link.external
                  ? { target: "_blank", rel: "noopener noreferrer" }
                  : {})}
                class="text-gray-600 transition-colors duration-300 hover:text-[var(--accent-color)]"
                style={`--accent-color: ${siteConfig.accentColor}`}
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-6 w-6"
                >
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  {link.icon.map((d) => (
                    <path d={d} />
                  ))}
                </svg>
              </a>
            ))
          }
        </div>
      </div>

      <div class="hidden md:flex flex-col md:items-end gap-4">
        <nav class="flex gap-x-8">
          <a
            href="#about"
            class="text-sm text-gray-600 hover:text-gray-800 transition-colors"
            >About</a
          >
          {
            hasProjects && (
              <a
                href="#projects"
                class="text-sm text-gray-600 hover:text-gray-800 transition-colors"
              >
                Projects
              </a>
            )
          }
          {
            hasExperience && (
              <a
                href="#experience"
                class="text-sm text-gray-600 hover:text-gray-800 transition-colors"
              >
                Experience
              </a>
            )
          }
          {
            hasEducation && (
              <a
                href="#education"
                class="text-sm text-gray-600 hover:text-gray-800 transition-colors"
              >
                Education
              </a>
            )
          }
        </nav>
      </div>
    </div>

    <!-- Copyright and template attribution (visible on all screen sizes) -->
    <div
      class="mt-10 pt-6 border-t border-gray-200 flex flex-col gap-1 text-sm text-gray-500 md:flex-row md:items-center md:justify-between"
    >
      <p>© {new Date().getFullYear()} {siteConfig.name}</p>
      <p id="template-credit">
        Template originally created by
        <a
          href="https://github.com/RyanFitzgerald/devportfolio"
          target="_blank"
          rel="noopener noreferrer"
          class="underline underline-offset-2 hover:text-gray-800"
          >Ryan Fitzgerald</a
        >
        (<a
          href="https://github.com/RyanFitzgerald/devportfolio/blob/master/LICENSE.md"
          target="_blank"
          rel="noopener noreferrer"
          class="underline underline-offset-2 hover:text-gray-800"
          >MIT License</a
        >) — customized by Ali Hassan Khan
      </p>
    </div>
  </div>

  <!-- Decorative pattern -->
  <div class="absolute inset-0 -z-10 overflow-hidden">
    <svg
      aria-hidden="true"
      class="absolute bottom-0 left-0 w-full h-24 text-gray-100"
    >
      <pattern
        id="footer-pattern"
        x="0"
        y="0"
        width="100"
        height="100"
        patternUnits="userSpaceOnUse"
      >
        <path
          d="M0 50 Q 25 40, 50 50 T 100 50"
          stroke="currentColor"
          stroke-width="0.5"
          fill="none"
          opacity="0.4"></path>
      </pattern>
      <rect width="100%" height="100%" fill="url(#footer-pattern)"></rect>
    </svg>
  </div>
</footer>
